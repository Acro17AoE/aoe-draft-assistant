# Local secrets — copy to `.env` and fill in. Never commit `.env`.

# JWT signing secret (required in production)
AUTH_SECRET=change-me-in-production

# Optional: SQLite by default; use Postgres in production
# DATABASE_URL=sqlite:///./local-data/app.db

# Comma-separated admin emails (enables Admin tab + /api/admin)
ADMIN_EMAIL=

# Comma-separated emails for Opponent Analysis (dropdown + report)
OPPONENT_ANALYSIS_EMAILS=

# Liquipedia LPDB v3 free API key (request via https://liquipedia.net/api)
# LIQUIPEDIA_API_KEY=
# LIQUIPEDIA_USER_AGENT=DRAFT-AoE2/1.0 (https://github.com/your-org/your-repo; you@example.com)
# LIQUIPEDIA_CONTACT=https://github.com/your-org/your-repo
